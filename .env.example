# Official Hermes dashboard
PORT=8080

# Required authentication. The supervisor maps these to the official
# HERMES_DASHBOARD_BASIC_AUTH_* variables without writing plaintext to config.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional independent session-signing seed. If omitted, the supervisor
# derives a stable signing secret from ADMIN_PASSWORD without logging it.
DASHBOARD_SESSION_SECRET=

# All other Hermes configuration (LLM providers, messaging channels, tool API keys)
# is managed through the official dashboard at /.
